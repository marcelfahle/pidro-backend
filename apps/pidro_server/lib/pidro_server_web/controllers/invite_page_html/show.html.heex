<%= if @crawler? do %>
  <main class="invite-crawler" data-crawler-preview>
    <p>Pidro invitation</p>
  </main>
<% else %>
  <main class="invite-shell">
    <div class="invite-suit invite-suit--heart" aria-hidden="true">♥</div>
    <div class="invite-suit invite-suit--club" aria-hidden="true">♣</div>

    <section class="invite-panel" data-state={@page.state}>
      <div class="invite-brand">
        <img
          src={static_url(@conn, ~p"/images/invite/logo.png")}
          width="196"
          height="121"
          alt="Pidro"
        />
      </div>

      <p class="invite-eyebrow">{@page.eyebrow}</p>
      <h1>{@page.heading}</h1>
      <p class="invite-copy">{@page.body}</p>

      <div :if={@page.state == :open} class="invite-seat-count" data-seat-count>
        <span class="invite-seat-dots" aria-hidden="true">
          <%= for index <- 1..@page.seats_total do %>
            <i class={if index <= @page.seats_taken, do: "is-filled", else: nil}></i>
          <% end %>
        </span>
        <strong>{@page.seat_copy}</strong>
      </div>

      <div class="invite-actions">
        <a
          :if={@page.table_action == :successor}
          class="invite-primary"
          href={@page.target_url}
          data-primary-action
        >
          Continue to the new table
        </a>

        <a
          :if={@page.table_action == :join and @page.device == :ios}
          class="invite-primary"
          href={@page.ios_url}
          data-primary-action
          data-open-ios
        >
          Open in Pidro
        </a>

        <a
          :if={@page.table_action == :join and @page.device == :android}
          class="invite-primary"
          href={@page.android_url}
          data-primary-action
          data-open-android
        >
          Open in Pidro
        </a>

        <p
          :if={@page.table_action == :join and @page.device == :desktop}
          class="invite-desktop-note"
        >
          Continue on your phone
        </p>

        <p class="invite-store-label">Get Pidro free</p>
        <p
          :if={@page.deferred_capture_url && @page.device in [:ios, :android]}
          class="invite-privacy-note"
        >
          To restore this invite after installation, Pidro may use coarse device and network
          details for up to 30 minutes.
          <a href="https://www.pidro.online/privacy-policy" data-invite-privacy>
            Privacy details
          </a>
        </p>
        <div class="invite-store-links" aria-label="Download Pidro">
          <a
            href={@page.app_store_url}
            data-store="apple"
            data-deferred-capture={if @page.device == :ios, do: @page.deferred_capture_url}
            data-deferred-platform={if @page.device == :ios, do: "ios"}
            aria-label="Download Pidro on the App Store"
          >
            <img
              src={static_url(@conn, ~p"/images/invite/app-store.png")}
              width="153"
              height="50"
              alt="Download on the App Store"
            />
          </a>
          <a
            href={@page.play_store_url}
            data-store="google"
            data-deferred-capture={if @page.device == :android, do: @page.deferred_capture_url}
            data-deferred-platform={if @page.device == :android, do: "android"}
            aria-label="Get Pidro on Google Play"
          >
            <img
              src={static_url(@conn, ~p"/images/invite/google-play.png")}
              width="168"
              height="50"
              alt="Get it on Google Play"
            />
          </a>
        </div>

        <p class="invite-fallback" data-ios-fallback hidden>
          Didn't open? <a
            href={@page.app_store_url}
            data-deferred-capture={if @page.device == :ios, do: @page.deferred_capture_url}
            data-deferred-platform={if @page.device == :ios, do: "ios"}
          >
            Get Pidro on the App Store
          </a>.
        </p>
      </div>

      <figure :if={@page.show_qr} class="invite-qr">
        <img
          src={@page.qr_data_uri}
          width="184"
          height="184"
          alt="QR code for this Pidro invite"
          data-invite-qr
          data-payload={@page.target_url}
        />
        <figcaption>Scan with your phone to join</figcaption>
      </figure>

      <p :if={@page.code} class="invite-code">
        Invite code <strong>{PidroServer.Invites.Codes.dashed(@page.code)}</strong>
      </p>
    </section>
  </main>
<% end %>
