#!/usr/bin/env bash
set -Eeuo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
server="${PIDRO_SERVER_SSH:-root@95.217.3.224}"
remote_tmp="/tmp/pidro-backup-install.$$"

ssh "$server" "mkdir -p '$remote_tmp'"
scp -q \
  "$repo_root/ops/server/pidro-backup" \
  "$repo_root/ops/server/pidro-backup.service" \
  "$repo_root/ops/server/pidro-backup.timer" \
  "$server:$remote_tmp/"

ssh "$server" "set -eu
  install -o root -g root -m 0750 '$remote_tmp/pidro-backup' /usr/local/sbin/pidro-backup
  install -o root -g root -m 0644 '$remote_tmp/pidro-backup.service' /etc/systemd/system/pidro-backup.service
  install -o root -g root -m 0644 '$remote_tmp/pidro-backup.timer' /etc/systemd/system/pidro-backup.timer
  rm -rf '$remote_tmp'
  systemctl daemon-reload
  systemctl enable --now pidro-backup.timer
  systemctl start pidro-backup.service
  systemctl --no-pager status pidro-backup.timer"
