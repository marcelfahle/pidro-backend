#!/usr/bin/env bash
set -Eeuo pipefail

# The API and socket probes must stay outside PidroServerWeb.Plugs.RateLimit's
# policies: a 429 would fail the deploy. The optional invite probe makes one
# request, well below the public preview limit. The X-Forwarded-For contract
# cannot be verified from here because nothing echoes the derived address; see
# docs/deployment/kamal_hetzner.md for the one-time production check.

backend_url="${PIDRO_BASE_URL:-https://app.pidro.online}"
public_url="${PIDRO_PUBLIC_URL:-$backend_url}"
backend_url="${backend_url%/}"
public_url="${public_url%/}"
tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT

health_body="$(curl --fail --silent --show-error --max-time 15 "$backend_url/up")"
test "$health_body" = "ok"

lobby_status="$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' --max-time 15 "$backend_url/api/v1/lobby")"
test "$lobby_status" = "401"

dev_status="$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' --max-time 15 "$backend_url/dev/games")"
test "$dev_status" = "404"

curl --silent --show-error --dump-header "$tmp_dir/cors.headers" --output /dev/null \
  --max-time 15 \
  --request OPTIONS \
  --header 'Origin: https://play.pidro.online' \
  --header 'Access-Control-Request-Method: GET' \
  "$backend_url/api/v1/lobby"

grep -Eiq '^access-control-allow-origin: https://play\.pidro\.online\r?$' "$tmp_dir/cors.headers"

socket_status="$(curl --http1.1 --silent --show-error --output /dev/null --write-out '%{http_code}' \
  --max-time 15 \
  --header 'Connection: Upgrade' \
  --header 'Upgrade: websocket' \
  --header 'Sec-WebSocket-Version: 13' \
  --header 'Sec-WebSocket-Key: cGlkcm8tc21va2UtdGVzdA==' \
  "$backend_url/socket/websocket?vsn=2.0.0")"
test "$socket_status" = "403"

aasa_status="$(curl --silent --show-error --dump-header "$tmp_dir/aasa.headers" --output "$tmp_dir/aasa.body" \
  --write-out '%{http_code}' --max-time 15 \
  "$public_url/.well-known/apple-app-site-association")"
test "$aasa_status" = "200"
grep -Eiq '^content-type: application/json' "$tmp_dir/aasa.headers"
grep -Eiq '^cache-control: public, max-age=3600' "$tmp_dir/aasa.headers"
! grep -Eiq '^set-cookie:' "$tmp_dir/aasa.headers"
grep -Fq 'com.oneapps.pidro' "$tmp_dir/aasa.body"
grep -Fq '"/":"/j/*"' "$tmp_dir/aasa.body"

root_aasa_status="$(curl --silent --show-error --dump-header "$tmp_dir/root-aasa.headers" --output "$tmp_dir/root-aasa.body" \
  --write-out '%{http_code}' --max-time 15 \
  "$public_url/apple-app-site-association")"
test "$root_aasa_status" = "200"
grep -Eiq '^content-type: application/json' "$tmp_dir/root-aasa.headers"
! grep -Eiq '^set-cookie:' "$tmp_dir/root-aasa.headers"
cmp --silent "$tmp_dir/aasa.body" "$tmp_dir/root-aasa.body"

assetlinks_status="$(curl --silent --show-error --dump-header "$tmp_dir/assetlinks.headers" --output "$tmp_dir/assetlinks.body" \
  --write-out '%{http_code}' --max-time 15 \
  "$public_url/.well-known/assetlinks.json")"
test "$assetlinks_status" = "200"
grep -Eiq '^content-type: application/json' "$tmp_dir/assetlinks.headers"
grep -Eiq '^cache-control: public, max-age=3600' "$tmp_dir/assetlinks.headers"
! grep -Eiq '^set-cookie:' "$tmp_dir/assetlinks.headers"
grep -Fq 'com.oneapps.pidro' "$tmp_dir/assetlinks.body"

if test -n "${PIDRO_INVITE_CODE:-}"; then
  invite_url="$public_url/j/$PIDRO_INVITE_CODE"
  invite_status="$(curl --silent --show-error --dump-header "$tmp_dir/invite.headers" --output "$tmp_dir/invite.body" \
    --write-out '%{http_code}' --max-time 15 \
    --header 'User-Agent: Slackbot-LinkExpanding 1.0' \
    "$invite_url")"

  test "$invite_status" = "200"
  grep -Eiq '^content-type: text/html' "$tmp_dir/invite.headers"
  grep -Eiq '^cache-control: no-store' "$tmp_dir/invite.headers"
  grep -Eiq '^vary: user-agent' "$tmp_dir/invite.headers"
  ! grep -Eiq '^set-cookie:' "$tmp_dir/invite.headers"
  grep -Fq "<link rel=\"canonical\" href=\"$invite_url\"" "$tmp_dir/invite.body"
  grep -Fq 'property="og:title"' "$tmp_dir/invite.body"
fi

echo "Production smoke checks passed for backend ${backend_url} and public host ${public_url}."
